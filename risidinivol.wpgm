import wollok.game.*
import objetos.*

program risidinivol {
    game.width(16)
    game.height(9)
    game.cellSize(128)
    game.title("Risidinivol")

    // ms que hay que mantener apretada la tecla antes de arrancar a moverse,
    // y también el paso entre movimientos mientras se mantiene
    const retraso = 150

    const tickArriba = game.tick(retraso, { personaje.moverArriba() }, false)
    const tickAbajo = game.tick(retraso, { personaje.moverAbajo() }, false)
    const tickIzquierda = game.tick(retraso, { personaje.moverIzquierda() }, false)
    const tickDerecha = game.tick(retraso, { personaje.moverDerecha() }, false)

    keyboard.up().onPressDo({
        personaje.direccion("arriba")
        tickArriba.start()
    })
    keyboard.up().onReleaseDo({ tickArriba.stop() })

    keyboard.down().onPressDo({
        personaje.direccion("abajo")
        tickAbajo.start()
    })
    keyboard.down().onReleaseDo({ tickAbajo.stop() })

    keyboard.left().onPressDo({
        personaje.direccion("izquierda")
        tickIzquierda.start()
    })
    keyboard.left().onReleaseDo({ tickIzquierda.stop() })

    keyboard.right().onPressDo({
        personaje.direccion("derecha")
        tickDerecha.start()
    })
    keyboard.right().onReleaseDo({ tickDerecha.stop() })

    game.start()
    game.addVisual(personaje)
}